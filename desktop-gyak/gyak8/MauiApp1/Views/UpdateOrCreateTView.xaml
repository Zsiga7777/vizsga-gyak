<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:viewModels="clr-namespace:MauiApp1.ViewModels"
             x:Class="MauiApp1.Views.UpdateOrCreateTView"
             x:DataType="viewModels:UpdateOrCreateTViewModel"
             x:Name="this"
             Title="">
    <VerticalStackLayout>
        <Button Text="Vissza" Command="{Binding ReturnCommand}"/>

        <Entry Placeholder="Tv neve" Text="{Binding Tv.Name}"/>
        <Entry Placeholder="Tv leírása" Text="{Binding Tv.Description}"/>
        <Entry Placeholder="Tv ára" Text="{Binding Tv.Price}"/>

        <Button Text="Mentés" Command="{Binding SaveCommand}"/>
    </VerticalStackLayout>
</ContentPage>